{
  "name": "darktime",
  "version": "5.0.0",
  "description": "The High-Contrast Digital Lab",
  "main": "electron-main.js",
  "author": "Md. Arman Hossen Ripon",
  "scripts": {
    "start": "electron .",
    "build:mac:native": "bash scripts/build-mac-native.sh",
    "build:mac": "electron-builder --mac dmg",
    "build:win": "electron-builder --win nsis portable"
  },
  "build": {
    "appId": "com.darktime.app",
    "productName": "DarkTime",
    "compression": "maximum",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron-main.js",
      "www/**/*",
      "!www/img/Screenshot*.png",
      "!www/img/*.png",
      "www/img/clock.png",
      "www/clock.png",
      "img/clock.png"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        "dmg"
      ],
      "icon": "img/clock.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "img/clock.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {},
  "devDependencies": {
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/core": "^8.3.1",
    "electron": "^35.1.1",
    "electron-builder": "^26.15.3"
  }
}
